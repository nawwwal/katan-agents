{
  "name": "katan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "rooms": "tsx server/dev-server.ts",
    "mcp": "tsx server/mcp.ts",
    "check:board": "tsx src/game/board.check.ts",
    "check:engine": "tsx src/game/engine.check.ts",
    "check:integrity": "tsx src/game/integrity.check.ts",
    "check:rules": "tsx src/game/rules.check.ts",
    "check:simulation": "tsx src/game/simulation.check.ts",
    "check:rooms": "tsx server/room-server.check.ts",
    "check:mcp": "tsx server/mcp.check.ts",
    "check:hosted-mcp": "tsx server/hosted-mcp.check.ts",
    "check:agent": "node agent-runner/check.mjs",
    "check:dice": "tsx src/scene/motion/diceThrow.check.ts",
    "check:sightline": "tsx src/scene/structures/sightline.check.ts",
    "pack:agent": "npm pack ./agent-runner --pack-destination ./public",
    "test": "npm run check:board && npm run check:engine && npm run check:integrity && npm run check:rules && npm run check:simulation && npm run check:rooms && npm run check:mcp && npm run check:hosted-mcp && npm run check:dice && npm run check:sightline && npm run check:agent",
    "bake": "node scripts/bake/index.mjs",
    "bake:sheet": "node scripts/bake/contact-sheet.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint src server",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "ioredis": "^5.11.1",
    "postprocessing": "^6.39.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.180.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.73.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vite": "^8.1.4"
  }
