{
  "name": "katan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "bridge": "node server/agent-bridge.mjs",
    "bridge:codex": "node server/codex-bridge.mjs",
    "check:board": "tsx src/game/board.check.ts",
    "check:engine": "tsx src/game/engine.check.ts",
    "check:integrity": "tsx src/game/integrity.check.ts",
    "check:rules": "tsx src/game/rules.check.ts",
    "check:simulation": "tsx src/game/simulation.check.ts",
    "check:bridge": "node server/agent-bridge.check.mjs",
    "test": "npm run check:board && npm run check:engine && npm run check:integrity && npm run check:rules && npm run check:simulation && npm run check:bridge",
    "typecheck": "tsc -b",
    "lint": "oxlint src server",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.73.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
